# ==============================================================================
# LearnPulse AI LMS — Environment Configuration Template (.env.example)
# Copy this file to .env before starting the Docker Compose environment:
#   cp .env.example .env
# IMPORTANT: Never commit .env containing production secrets to version control.
# ==============================================================================

# --- Application Profile ---
# Options: dev, prod (Week 14 enforces production-grade JWT secret validation in prod)
SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL & pgvector Database Configuration ---
DB_HOST=db
DB_PORT=5432
DB_NAME=learning_assistant_db
DB_USERNAME=postgres
# In production, specify a strong, unique database password
DB_PASSWORD=SecureLearnPulsePass2026!

# --- Security & JWT Authentication ---
# CRITICAL: Week 14 JwtProvider requires valid Base64 decoding to >= 32 bytes (256 bits).
# The default development secret is strictly blocked in 'prod'/'production' profiles.
# Generate a secure, unique Base64-encoded secret for production using:
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_256BIT_SECRET_RUN_OPENSSL_RAND_BASE64_64

# --- AI & Ollama Configuration ---
# Container-to-container URL uses Docker Compose service name 'ollama'
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_TEMPERATURE=0.7
OLLAMA_CONNECT_TIMEOUT_MS=10000
OLLAMA_READ_TIMEOUT_MS=60000

# --- File Storage ---
FILE_UPLOAD_DIR=/app/uploads/

# --- Port Mappings (Host : Container) ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT_MAP=5432
OLLAMA_PORT_MAP=11434

# --- Frontend Build Configuration ---
# Uses relative /api for Nginx reverse-proxy pass-through
VITE_API_BASE_URL=/api
